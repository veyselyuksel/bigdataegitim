CREATE TABLE customers (
    customer_id INT,
    name STRING,
    city STRING
)
STORED AS ORC;

CREATE TABLE sales (
    sale_id INT,
    customer_id INT,
    amount DECIMAL(10,2),
    sale_date STRING
)
PARTITIONED BY (year STRING)
STORED AS ORC;

