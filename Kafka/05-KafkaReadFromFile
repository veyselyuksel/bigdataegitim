Yeni bir topic oluşturulur

/opt/kafka/bin/kafka-topics.sh \
  --bootstrap-server spark-master01:9092 \
  --create \
  --topic logtopic \
  --partitions 3 \
  --replication-factor 2

  topic oluştu mu doğrula

  /opt/kafka/bin/kafka-topics.sh \
  --bootstrap-server spark-master01:9092 \
  --describe --topic logtopic


2) producer2.py scriptini oluştur

from kafka import KafkaProducer
import time
import os

TOPIC = "logtopic"
BROKERS = ["spark-master01:9092"]
FILE_PATH = "sample.txt"

producer = KafkaProducer(
    bootstrap_servers=BROKERS,
    value_serializer=lambda v: v.encode("utf-8")
)

# Dosyayı tail modunda aç
with open(FILE_PATH, "r") as f:
    # Dosyanın sonuna git
    f.seek(0, os.SEEK_END)
    while True:
        line = f.readline()
        if not line:
            time.sleep(1)  # yeni satır gelmesini bekle
            continue
        line = line.strip()
        if line:
            producer.send(TOPIC, line)
            print(f"Produced: {line}")

3) consumer2.py scriptini oluştur

from kafka import KafkaConsumer

TOPIC = "logtopic"
BROKERS = ["spark-master01:9092"]

consumer = KafkaConsumer(
    TOPIC,
    bootstrap_servers=BROKERS,
    auto_offset_reset="earliest",
    enable_auto_commit=True,
    group_id="log-consumer-group",
    value_deserializer=lambda v: v.decode("utf-8")
)

print("Listening for messages...")

for message in consumer:
    print(f"Consumed: {message.value}")


