from kafka import KafkaConsumer

consumer = KafkaConsumer(
    "sampletopic1",
    bootstrap_servers=["spark-master:9092", "spark-worker-0:9092"],
    group_id="py-consumer-kp",
    auto_offset_reset="earliest",           # grup yoksa baştan
    enable_auto_commit=True,
    value_deserializer=lambda b: b.decode("utf-8"),
)

print("Mesajlar dinleniyor (Ctrl+C ile çık)…")
try:
    for msg in consumer:
        print(f"{msg.topic}[{msg.partition}]@{msg.offset} -> {msg.value}")
except KeyboardInterrupt:
    pass
finally:
    consumer.close()

2- Açıklama
from kafka import KafkaConsumer   # Kafka consumer kütüphanesini import ediyoruz

# KafkaConsumer nesnesini oluşturuyoruz
consumer = KafkaConsumer(
    "sampletopic1",                         # Dinlenecek topic adı
    bootstrap_servers=["spark-master:9092", "spark-worker-0:9092"],  # Broker adresleri
    group_id="py-consumer-kp",              # Consumer Group kimliği (aynı gruptaki consumer’lar işi paylaşır)
    auto_offset_reset="earliest",           # Daha önce offset kaydı yoksa en baştan (earliest) başlat
    enable_auto_commit=True,                # Mesaj okundukça offset otomatik commit edilsin
    value_deserializer=lambda b: b.decode("utf-8"),  # Mesaj byte → string dönüşümü
)

print("Mesajlar dinleniyor (Ctrl+C ile çık)…")   # Kullanıcıya bilgi veriyoruz

try:
    for msg in consumer:   # Gelen her mesaj için döngü
        # Mesajın detaylarını yazdır: topic adı, partition numarası, offset ve mesaj içeriği
        print(f"{msg.topic}[{msg.partition}]@{msg.offset} -> {msg.value}")
except KeyboardInterrupt:   # Ctrl+C ile çıkıldığında
    pass
finally:
    consumer.close()        # Consumer bağlantısını kapat

