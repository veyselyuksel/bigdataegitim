1-Açıklamalı

from kafka import KafkaProducer      # Kafka producer kütüphanesini import ediyoruz
import sys                           # Konsoldan satır okumak için sys modülü

# Producer nesnesini oluşturuyoruz
producer = KafkaProducer(
    bootstrap_servers=["spark-master:9092", "spark-worker-0:9092"],  # Kafka broker adresleri
    value_serializer=lambda v: v.encode("utf-8"),  # Gönderilecek mesajları UTF-8 string'e çevirir
    client_id="py-producer-kp"                     # Producer kimliği (loglarda görünecek)
)

topic = "sampletopic1"              # Mesajların gönderileceği topic adı
print("Satır yaz ve Enter'a bas (Ctrl+C ile çık):")  # Kullanıcıya bilgi veriyoruz

try:
    for line in sys.stdin:          # Konsoldan satır satır girdi okuyoruz
        line = line.strip()         # Satırın başındaki/sonundaki boşlukları temizle
        if line:                    # Eğer boş satır değilse
            future = producer.send(topic, value=line)  # Mesajı Kafka'ya gönder
            # İstersen senkron bekleme (metadata almak için):
            # record_metadata = future.get(timeout=10)  # Gönderim tamamlanana kadar bekler
            # print(record_metadata.topic,             # Hangi topic'e yazıldı
            #       record_metadata.partition,         # Hangi partition'a yazıldı
            #       record_metadata.offset)            # Offset değeri
except KeyboardInterrupt:            # Ctrl+C ile çıkıldığında
    pass
finally:
    producer.flush()                 # Gönderilmeyi bekleyen mesajları gönder
    producer.close()                 # Producer bağlantısını kapat


