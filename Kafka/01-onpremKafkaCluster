# 1. Java (OpenJDK 17 önerilir)
sudo dnf install -y java-17-openjdk

# 2. kafka kullanıcı/grup
sudo useradd -r -m -d /opt/kafka kafka 

# 3. Dizinler
sudo mkdir -p /opt/kafka/{bin,config,logs}
sudo mkdir -p /data/kafka-logs          # broker log segmentleri
sudo mkdir -p /data/kraft-metadata      # controller metadata (sadece controller node'da kullanılır)
sudo chown -R kafka:kafka /opt/kafka /data

