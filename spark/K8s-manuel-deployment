02- Yaml dosyaları hazırlanır.
**********SPARK-MASTER-DEPLOYMENT YAML içeriği****
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: spark-master
  namespace: spark
spec:
  serviceName: "spark-master-headless"
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: spark
      app.kubernetes.io/component: master
  template:
    metadata:
      labels:
        app.kubernetes.io/name: spark
        app.kubernetes.io/component: master
    spec:
      containers:
        - name: spark
          image: bitnami/spark:4.0.0
          imagePullPolicy: IfNotPresent
          env:
            - name: SPARK_MODE
              value: master
          ports:
            - name: webui
              containerPort: 8080
            - name: spark
              containerPort: 7077

**********spark-master-service.yaml
apiVersion: v1
kind: Service
metadata:
  name: spark-master-svc
  namespace: spark
spec:
  type: NodePort
  selector:
    app.kubernetes.io/name: spark
    app.kubernetes.io/component: master
  ports:
    - name: webui
      port: 8080
      targetPort: 8080
      nodePort: 30750
    - name: spark
      port: 7077
      targetPort: 7077
      nodePort: 31135

**********spark-worker-deployment.yaml

apiVersion: apps/v1
kind: Deployment
metadata:
  name: spark-worker
  namespace: spark
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: spark
      app.kubernetes.io/component: worker
  template:
    metadata:
      labels:
        app.kubernetes.io/name: spark
        app.kubernetes.io/component: worker
    spec:
      containers:
        - name: spark
          image: bitnami/spark:4.0.0
          imagePullPolicy: IfNotPresent
          env:
            - name: SPARK_MODE
              value: worker
            - name: SPARK_MASTER_URL
              value: spark://spark-master-svc.spark.svc.cluster.local:7077
          ports:
            - name: worker-ui
              containerPort: 8081
              


