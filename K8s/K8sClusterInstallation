K8s CLuster Kurulumu

1 master 2 worker node ile K8s cluster kurulumu

1) vi ile prereq.sh adında bir sh dosyası oluşturulur.
- 3 node'da da çalıştırılır.

#!/bin/bash

set -e

echo "[INFO] Disabling swap..."
sudo swapoff -a
sudo sed -i '/ swap / s/^/#/' /etc/fstab

echo "[INFO] Disabling SELinux..."
sudo setenforce 0
sudo sed -i 's/^SELINUX=enforcing/SELINUX=disabled/' /etc/selinux/config

echo "[INFO] Loading br_netfilter kernel module..."
sudo modprobe br_netfilter

echo "[INFO] Adding kernel sysctl settings for Kubernetes..."
cat <<EOF | sudo tee /etc/sysctl.d/k8s.conf
net.bridge.bridge-nf-call-ip6tables = 1
net.bridge.bridge-nf-call-iptables = 1
net.ipv4.ip_forward = 1
EOF

sudo tee -a /etc/sysctl.d/99-kubernetes-ipforward.conf <<EOF
net.ipv4.ip_forward = 1
EOF
sudo systemctl stop firewalld
sudo systemctl disable firewalld
echo -e "overlay\nbr_netfilter" | sudo tee /etc/modules-load.d/k8s.conf > /dev/null
sudo modprobe overlay
sudo modprobe br_netfilter
echo "[INFO] Applying sysctl settings..."
sudo sysctl --system

echo "[INFO] Setup complete. Please reboot the system manually if needed."

