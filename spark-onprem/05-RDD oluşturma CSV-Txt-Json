
CSV'den RDD oluşturma

df_csv = spark.read.csv("file:///tmp/simple.csv", header=True, inferSchema=True)
rdd_csv = df_csv.rdd  
print("DF şeması:")
df_csv.printSchema()
print("RDD örnekleri:", rdd_csv.take(2))
pairs_csv = rdd_csv.map(lambda row: (row["name"], row["score"]))
print("Pairs:", pairs_csv.collect())

