from pyspark.sql import SparkSession
from pyspark.sql import functions as F

spark = (SparkSession.builder
         .appName("CSV+JSON Union Example")
         .getOrCreate())

# --- CSV'yi oku ---
df_csv = (spark.read
    .option("header", True)
    .option("inferSchema", True)   # demo için
    .csv("/home/spark/data.csv")
    .withColumn("source", F.lit("csv")))

# CSV'de city yok; union sırasında hizalamak için ekleyelim (null)
df_csv = df_csv.withColumn("city", F.lit(None).cast("string"))

# --- JSON'u oku ---
df_json = (spark.read
    .option("multiline", True)     # JSON array için
    .json("/home/spark/data.json")
    .withColumn("source", F.lit("json")))

# Tipleri netleştirelim (union'da sorun çıkmasın)
df_csv = df_csv.select(
    F.col("name").cast("string"),
    F.col("class").cast("string"),
    F.col("score").cast("int"),
    F.col("city").cast("string"),
    F.col("source")
)

df_json = df_json.select(
    F.col("name").cast("string"),
    F.col("class").cast("string"),
    F.col("score").cast("int"),
    F.col("city").cast("string"),
    F.col("source")
)

# --- Birleştir (kolon adları aynı hizadaysa unionByName şart değil, ama güvenli tercih) ---
df_all = df_csv.unionByName(df_json, allowMissingColumns=True)

print("=== Birleşik DataFrame (CSV+JSON) ===")
df_all.show(truncate=False)
df_all.printSchema()

# Küçük analizler:
print("Kayıt sayısı:", df_all.count())  # 6 kayıt: 3 CSV + 3 JSON

# 80+ skorlar
df_all.filter(F.col("score") >= 80).show()

# class bazında özet
(df_all.groupBy("class")
      .agg(F.count("*").alias("cnt"), F.avg("score").alias("avg_score"))
      .orderBy(F.desc("avg_score"))
      .show())

# Kaynağa göre dağılım
(df_all.groupBy("source").count().show())


# --- SQL ile her sınıftaki en yüksek puan (sadece skor) ---
df_all.createOrReplaceTempView("scores_all")

spark.sql("""
    SELECT class,
           MAX(score) AS max_score
    FROM scores_all
    GROUP BY class
    ORDER BY class
""").show()

# --- SQL ile her sınıftaki en yüksek puanı alan KİŞİ(ler) + skor ---
# (Eşit puan durumunda hepsini döndürür: RANK() kullanıyoruz)
spark.sql("""
    SELECT class, name, score
    FROM (
        SELECT
            class,
            name,
            score,
            RANK() OVER (PARTITION BY class ORDER BY score DESC) AS rnk
        FROM scores_all
    )
    WHERE rnk = 1
    ORDER BY class, name
""").show()







