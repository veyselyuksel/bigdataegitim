spark = (SparkSession.builder
         .appName("CSV+JSON Union Example")  # Uygulama adı belirleniyor
         .getOrCreate())                      # SparkSession başlatılıyor

# --- CSV'yi oku ---
df_csv = (spark.read
    .option("header", True)                  # İlk satır kolon isimleri olarak kullanılacak
    .option("inferSchema", True)              # Veri tiplerini otomatik algıla (demo amaçlı)
    .csv("/home/spark/data.csv")              # CSV dosyasının yolu
    .withColumn("source", F.lit("csv")))      # Kaynağı belirten ek kolon ekle ("csv")

# CSV'de city yok; union sırasında hizalamak için ekleyelim (null)
df_csv = df_csv.withColumn("city", F.lit(None).cast("string"))  # Eksik kolon city ekleniyor, null değer

# --- JSON'u oku ---
df_json = (spark.read
    .option("multiline", True)                # JSON dosyası bir array ise satır sonları dikkate alınsın
    .json("/home/spark/data.json")             # JSON dosyasının yolu
    .withColumn("source", F.lit("json")))      # Kaynağı belirten ek kolon ekle ("json")

# Tipleri netleştirelim (union'da sorun çıkmasın)
df_csv = df_csv.select(
    F.col("name").cast("string"),             # name string tipinde
    F.col("class").cast("string"),            # class string tipinde
    F.col("score").cast("int"),               # score int tipinde
    F.col("city").cast("string"),             # city string tipinde
    F.col("source")                           # source string (zaten eklenmiş)
)

df_json = df_json.select(
    F.col("name").cast("string"),
    F.col("class").cast("string"),
    F.col("score").cast("int"),
    F.col("city").cast("string"),
    F.col("source")
)

# --- Birleştir ---
df_all = df_csv.unionByName(df_json, allowMissingColumns=True)  # Kolon isimlerine göre birleştir (güvenli yöntem)

print("=== Birleşik DataFrame (CSV+JSON) ===")
df_all.show(truncate=False)       # Tüm verileri satır kırpmadan göster
df_all.printSchema()              # DataFrame şemasını göster

# Küçük analizler:
print("Kayıt sayısı:", df_all.count())  # Tüm satırların sayısı

# 80+ skorlar
df_all.filter(F.col("score") >= 80).show()  # score >= 80 olan satırları göster

# class bazında özet
(df_all.groupBy("class")                   # class'a göre grupla
      .agg(F.count("*").alias("cnt"),       # satır sayısı
           F.avg("score").alias("avg_score"))  # ortalama score
      .orderBy(F.desc("avg_score"))         # ortalama score'a göre azalan sırala
      .show())

# Kaynağa göre dağılım
(df_all.groupBy("source").count().show())  # CSV ve JSON kaynaklarının dağılımı

# --- SQL ile her sınıftaki en yüksek puan (sadece skor) ---
df_all.createOrReplaceTempView("scores_all")  # DataFrame'i SQL sorguları için temp view olarak kaydet

spark.sql("""
    SELECT class,
           MAX(score) AS max_score         -- Her sınıfın maksimum puanı
    FROM scores_all
    GROUP BY class
    ORDER BY class
""").show()

# --- SQL ile her sınıftaki en yüksek puanı alan KİŞİ(ler) + skor ---
# Eşit puan varsa hepsini döndürmek için RANK() kullanıyoruz
spark.sql("""
    SELECT class, name, score
    FROM (
        SELECT
            class,
            name,
            score,
            RANK() OVER (PARTITION BY class ORDER BY score DESC) AS rnk
        FROM scores_all
    )
    WHERE rnk = 1                      -- Sadece en yüksek puana sahip olan(lar)
    ORDER BY class, name
""").show()
