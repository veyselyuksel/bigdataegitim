Dataframe oluşturma

***Örnek*****
from pyspark.sql import functions as F
from pyspark.sql.types import StructType, StructField, StringType, IntegerType

# Örnek veri satırları: (isim, sınıf, puan)
rows = [("alice", "A", 85),
        ("bob",   "B", 90),
        ("carl",  "A", 78),
        ("dina",  "B", 92),
        ("eric",  "A", 60)]

# DataFrame için açık bir schema tanımlıyoruz
# Her sütunun adı (name, class, score), tipi (StringType, IntegerType) ve boş olma durumu belirtilir
schema = StructType([
    StructField("name",  StringType(), nullable=False),   # Öğrenci adı (string, boş olamaz)
    StructField("class", StringType(), nullable=False),   # Sınıf bilgisi (string, boş olamaz)
    StructField("score", IntegerType(), nullable=False),  # Puan bilgisi (integer, boş olamaz)
])

# rows listesinden ve schema bilgisinden DataFrame oluşturuyoruz
df = spark.createDataFrame(rows, schema=schema)

df.printSchema()   # DataFrame'in şema (kolon isimleri ve tipleri) bilgisini yazdırır
df.show()          # DataFrame'in ilk satırlarını tablo formatında gösterir



