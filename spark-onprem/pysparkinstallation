Kurulumlar 2 node'a da yapılmalıdır.
Tüm spark node'larında sudo yetkili user ile

sudo mkdir -p /opt/py312
sudo python3.12 -m venv /opt/py312
sudo chown -R spark:spark /opt/py312
sudo chmod -R 755 /opt/py312
source /opt/py312/bin/activate


sudo su - spark
source /opt/py312/bin/activate
pip install --upgrade pip setuptools wheel
pip install pyspark==4.0.0

spark user'ın bashrc dosyasına aşağıdaki satırları ekle

export PYSPARK_PYTHON=/opt/py312/bin/python
export PYSPARK_DRIVER_PYTHON=/opt/py312/bin/python

spark-defaults.conf dosyasını oluştur ve  içeriğini aşağıdaki gibi ayarla

spark.pyspark.python=/opt/py312/bin/python
spark.pyspark.driver.python=/opt/py312/bin/python


Master sunucuda servisleri restart et.
 
stop-workers.sh 
stop-master.sh 
start.master.sh
start-worker.sh 

