Master ve worker sunucularda spark-env.sh dosyasının içine aşağıdaki satırlar eklenir.
export PYSPARK_PYTHON=/usr/bin/python3.12
export PYSPARK_DRIVER_PYTHON=/usr/bin/python3.12

Örnek uygulama

data = [("maths", 52), ("english", 75), ("science", 82), ("computer", 65), ("maths", 85)]
rdd = sc.parallelize(data, numSlices=2)
sorted_rdd = rdd.sortByKey(ascending=True)
for item in sorted_rdd.collect():
    print(item)

