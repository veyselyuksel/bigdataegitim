ETL script*********************

from pyspark.sql import SparkSession, functions as F, types as T
from pyspark import StorageLevel
import os

# -----------------------------
# Parametreler (gerekirse değiştir)
# -----------------------------
BASE = "/home/spark/etl_demo"             # proje kökü
IN  = os.path.join(BASE, "input")         # input klasörü
OUT = os.path.join(BASE, "output")        # output klasörü
os.makedirs(OUT, exist_ok=True)

CUSTOMERS_PATH = os.path.join(IN, "customers.csv")
ORDERS_PATH    = os.path.join(IN, "orders.csv")

spark = (SparkSession.builder
         .appName("ETL Demo - CSV to Parquet/CSV")
         .config("spark.sql.shuffle.partitions", 8)     # eğitim için düşük tut
         .getOrCreate())

# -------------------------------------------------------
# 1) EXTRACT — CSV dosyalarını DataFrame olarak oku
# -------------------------------------------------------
# Schema açık vermek prod’da daha iyi pratik (inferSchema yerine)
customers_schema = T.StructType([
    T.StructField("customer_id", T.IntegerType(), False),
    T.StructField("name",        T.StringType(),  True),
    T.StructField("region",      T.StringType(),  True),
])

orders_schema = T.StructType([
    T.StructField("order_id",     T.IntegerType(), False),
    T.StructField("customer_id",  T.IntegerType(), False),
    T.StructField("order_amount", T.DoubleType(),  True),
    T.StructField("order_date",   T.StringType(),  True),  # string okuyup to_date yapacağız
])

df_customers = (spark.read
    .option("header", True)
    .schema(customers_schema)
    .csv(CUSTOMERS_PATH))

df_orders = (spark.read
    .option("header", True)
    .schema(orders_schema)
    .csv(ORDERS_PATH))

# Hızlı kontrol
print("Customers:"); df_customers.show()
print("Orders:");    df_orders.show()

# -------------------------------------------------------
# 2) TRANSFORM — temizleme, tip dönüşümü, join, agregasyon
# -------------------------------------------------------

# 2.1 Tarih tipine çevir + null kayıt temizliği
df_orders_typed = (df_orders
    .withColumn("order_date", F.to_date("order_date", "yyyy-MM-dd"))
    .dropna(subset=["customer_id", "order_amount"])
)

# 2.2 İş kuralları: negatif/0 siparişleri dışla (örnek)
df_orders_clean = df_orders_typed.filter(F.col("order_amount") > 0)

# 2.3 Join (customers × orders)
df_joined = (df_orders_clean
    .join(df_customers, on="customer_id", how="inner"))

# 2.4 Zenginleştirme: yıl/ay kolonları + high_value flag
df_enriched = (df_joined
    .withColumn("order_year", F.year("order_date"))
    .withColumn("order_month", F.month("order_date"))
    .withColumn("is_high_value", (F.col("order_amount") >= 1000).cast("boolean"))
)

# 2.5 Agregasyon — müşteri başına toplam harcama, sipariş sayısı, son sipariş tarihi
df_customer_agg = (df_enriched
    .groupBy("customer_id", "name", "region")
    .agg(
        F.count("*").alias("order_cnt"),
        F.sum("order_amount").alias("total_spent"),
        F.max("order_date").alias("last_order_date"),
        F.sum(F.col("is_high_value").cast("int")).alias("high_value_orders")
    )
    .orderBy(F.desc("total_spent"))
)

# 2.6 Bölge/yıl bazında özet (opsiyonel örnek)
df_region_year = (df_enriched
    .groupBy("region", "order_year")
    .agg(
        F.count("*").alias("orders"),
        F.avg("order_amount").alias("avg_amount"),
        F.sum("order_amount").alias("sum_amount")
    )
    .orderBy("region", "order_year")
)

# Cache örneği (aynı DF’yi birkaç yerde kullanacaksak)
df_customer_agg.persist(StorageLevel.MEMORY_AND_DISK)
df_customer_agg.count()  # materialize

# -------------------------------------------------------
# 3) LOAD — çıktıların yazılması
# -------------------------------------------------------

# 3.1 Parquet (columnar, hızlı okuma/yazma)
out_parquet_1 = os.path.join(OUT, "customer_metrics_parquet")
df_customer_agg.write.mode("overwrite").parquet(out_parquet_1)

out_parquet_2 = os.path.join(OUT, "region_year_metrics_parquet")
df_region_year.write.mode("overwrite").parquet(out_parquet_2)

# 3.2 CSV (tek dosya yazmak için coalesce)
out_csv_1 = os.path.join(OUT, "customer_metrics_csv")
(df_customer_agg
    .coalesce(1)  # demo için tek dosya
    .write.mode("overwrite").option("header", True).csv(out_csv_1))

# 3.3 SQL ile de erişmek istersen temp view oluştur
df_customer_agg.createOrReplaceTempView("customer_metrics")
spark.sql("""
    SELECT region,
           COUNT(*) AS customers,
           SUM(total_spent) AS sum_spent
    FROM customer_metrics
    GROUP BY region
    ORDER BY sum_spent DESC
""").show()

# (İş bittiğinde cache/persist’i temizlemek iyi pratik)
df_customer_agg.unpersist()

print("Yazılan klasörler:")
print(" -", out_parquet_1)
print(" -", out_parquet_2)
print(" -", out_csv_1)

spark.stop()






