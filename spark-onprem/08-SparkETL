from pyspark.sql import SparkSession, functions as F, types as T   # SparkSession (giriş noktası), fonksiyonlar ve tipler
from pyspark import StorageLevel                                   # Persist/Cache seviyelerini seçmek için
import os                                                          # Dosya/dizin işlemleri için

# -----------------------------
# Parametreler (gerekirse değiştir)
# -----------------------------
BASE = "/home/spark/etl_demo"             # Proje kök klasörü (tüm path'ler bunun altında)
IN  = os.path.join(BASE, "input")         # Girdi dosyalarının bulunduğu klasör
OUT = os.path.join(BASE, "output")        # Çıktıların yazılacağı klasör
os.makedirs(OUT, exist_ok=True)           # Çıkış klasörü yoksa oluştur (tekrar çalıştırmada hata vermesin)

CUSTOMERS_PATH = os.path.join(IN, "customers.csv")  # customers CSV tam yolu
ORDERS_PATH    = os.path.join(IN, "orders.csv")     # orders CSV tam yolu

spark = (SparkSession.builder
         .appName("ETL Demo - CSV to Parquet/CSV")  # Spark uygulama adı (UI'da görünür)
         .config("spark.sql.shuffle.partitions", 8)  # Shuffle sonrası kullanılacak partition sayısı (demo için düşük)
         .getOrCreate())                             # SparkSession oluştur/geri getir

# -------------------------------------------------------
# 1) EXTRACT — CSV dosyalarını DataFrame olarak oku
# -------------------------------------------------------
# Schema açık vermek prod’da daha iyi pratik (inferSchema yerine)  # Şemayı kodla belirlemek tip/performans için güvenli

customers_schema = T.StructType([                                   # customers için şema
    T.StructField("customer_id", T.IntegerType(), False),           # Zorunlu tamsayı müşteri id
    T.StructField("name",        T.StringType(),  True),            # İsim (opsiyonel)
    T.StructField("region",      T.StringType(),  True),            # Bölge (opsiyonel)
])

orders_schema = T.StructType([                                      # orders için şema
    T.StructField("order_id",     T.IntegerType(), False),          # Sipariş id (zorunlu)
    T.StructField("customer_id",  T.IntegerType(), False),          # Müşteri id (zorunlu) – join anahtarımız
    T.StructField("order_amount", T.DoubleType(),  True),           # Sipariş tutarı (opsiyonel)
    T.StructField("order_date",   T.StringType(),  True),           # Tarihi string alıp to_date ile çevireceğiz
])

df_customers = (spark.read
    .option("header", True)                                         # İlk satırı kolon adı olarak kabul et
    .schema(customers_schema)                                       # Belirlediğimiz şemayı kullan
    .csv(CUSTOMERS_PATH))                                           # CSV'yi oku → DataFrame oluştur

df_orders = (spark.read
    .option("header", True)                                         # İlk satır başlık
    .schema(orders_schema)                                          # Belirlenen şema
    .csv(ORDERS_PATH))                                              # Orders CSV'yi oku

# Hızlı kontrol
print("Customers:"); df_customers.show()                            # Customers verisini tablo gibi göster
print("Orders:");    df_orders.show()                               # Orders verisini göster (gözle kontrol için)

# -------------------------------------------------------
# 2) TRANSFORM — temizleme, tip dönüşümü, join, agregasyon
# -------------------------------------------------------

# 2.1 Tarih tipine çevir + null kayıt temizliği
df_orders_typed = (df_orders
    .withColumn("order_date", F.to_date("order_date", "yyyy-MM-dd"))  # String tarih → Date tipine dönüştür
    .dropna(subset=["customer_id", "order_amount"])                   # Join ve hesaplama için kritik alanlar null olamaz
)

# 2.2 İş kuralları: negatif/0 siparişleri dışla (örnek)
df_orders_clean = df_orders_typed.filter(F.col("order_amount") > 0)   # 0 veya negatif tutarları ele (veri kalitesi)

# 2.3 Join (customers × orders)
df_joined = (df_orders_clean
    .join(df_customers, on="customer_id", how="inner"))               # customer_id üzerinden inner join (sadece eşleşenler)

# 2.4 Zenginleştirme: yıl/ay kolonları + high_value flag
df_enriched = (df_joined
    .withColumn("order_year", F.year("order_date"))                   # Yıl kolonu (raporlama için yararlı)
    .withColumn("order_month", F.month("order_date"))                 # Ay kolonu
    .withColumn("is_high_value", (F.col("order_amount") >= 1000).cast("boolean"))  # 1000+ siparişleri işaretle
)

# 2.5 Agregasyon — müşteri başına toplam harcama, sipariş sayısı, son sipariş tarihi
df_customer_agg = (df_enriched
    .groupBy("customer_id", "name", "region")                         # Müşteri bazında grupla
    .agg(
        F.count("*").alias("order_cnt"),                              # Sipariş adedi
        F.sum("order_amount").alias("total_spent"),                   # Toplam harcama
        F.max("order_date").alias("last_order_date"),                 # Son sipariş tarihi
        F.sum(F.col("is_high_value").cast("int")).alias("high_value_orders")  # Yüksek tutarlı sipariş adedi
    )
    .orderBy(F.desc("total_spent"))                                   # Toplam harcamaya göre azalan sırala
)

# 2.6 Bölge/yıl bazında özet (opsiyonel örnek)
df_region_year = (df_enriched
    .groupBy("region", "order_year")                                  # Bölge + Yıl kırılımında
    .agg(
        F.count("*").alias("orders"),                                 # Sipariş sayısı
        F.avg("order_amount").alias("avg_amount"),                    # Ortalama tutar
        F.sum("order_amount").alias("sum_amount")                     # Toplam tutar
    )
    .orderBy("region", "order_year")                                  # Okunabilirlik için sıralama
)

# Cache örneği (aynı DF’yi birkaç yerde kullanacaksak)
df_customer_agg.persist(StorageLevel.MEMORY_AND_DISK)                 # Bellek yetmezse diske spill edebilsin
df_customer_agg.count()                                               # İlk action: DF'yi materialize eder ve cache'e yükler

# -------------------------------------------------------
# 3) LOAD — çıktıların yazılması
# -------------------------------------------------------

# 3.1 Parquet (columnar, hızlı okuma/yazma)
out_parquet_1 = os.path.join(OUT, "customer_metrics_parquet")         # Müşteri metrikleri için parquet çıkış klasörü
df_customer_agg.write.mode("overwrite").parquet(out_parquet_1)        # Var ise üzerine yaz

out_parquet_2 = os.path.join(OUT, "region_year_metrics_parquet")      # Bölge-yıl metrikleri için çıkış klasörü
df_region_year.write.mode("overwrite").parquet(out_parquet_2)         # Parquet olarak yaz

# 3.2 CSV (tek dosya yazmak için coalesce)
out_csv_1 = os.path.join(OUT, "customer_metrics_csv")                 # CSV çıkış klasörü
(df_customer_agg
    .coalesce(1)                                                      # Demo için tek dosya üret (prod’da küçük dosya sorunu yaratabilir)
    .write.mode("overwrite").option("header", True).csv(out_csv_1))   # Başlık satırıyla CSV yaz

# 3.3 SQL ile de erişmek istersen temp view oluştur
df_customer_agg.createOrReplaceTempView("customer_metrics")           # SQL'de kullanılacak geçici view oluştur

# Aşağıdaki sorgu: bölge bazında müşteri sayısı ve toplam harcama
spark.sql("""
    SELECT region,
           COUNT(*) AS customers,
           SUM(total_spent) AS sum_spent
    FROM customer_metrics
    GROUP BY region
    ORDER BY sum_spent DESC
""").show()                                                           # Sonucu göster (UI'da planı da inceleyebilirsin)

# (İş bittiğinde cache/persist’i temizlemek iyi pratik)
df_customer_agg.unpersist()                                           # Cache/persist'i serbest bırak

print("Yazılan klasörler:")                                           # Çıktı patikalarını yazdır
print(" -", out_parquet_1)
print(" -", out_parquet_2)
print(" -", out_csv_1)

spark.stop()              
